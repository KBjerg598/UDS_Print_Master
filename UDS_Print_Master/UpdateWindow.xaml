<Window x:Class="UDS_Print_Master.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Центр обновлений UISI PrintMaster"
        Width="820"
        Height="650"
        MinWidth="720"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="Assets/UISI-Logo-BW.ico"
        Style="{StaticResource AppWindowStyle}"
        TextElement.Foreground="{StaticResource AppInkBrush}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="UpdatePrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style x:Key="UpdateSecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="54"
                    Height="54"
                    Padding="5"
                    VerticalAlignment="Center"
                    Background="#111827"
                    CornerRadius="8">
                <Image Source="Assets/UISI-Logo-Header.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="Центр обновлений" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource AppMutedBrush}"
                           Text="UISI PrintMaster" />
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="11,7"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppSoftBlueBrush}"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="17"
                                             Height="17"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Foreground="#2563EB"
                                             Kind="Github" />
                    <TextBlock x:Name="SourceBadgeText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8"
                               Text="GitHub Releases" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border x:Name="StatusPanel"
                        MinHeight="164"
                        Padding="22"
                        Background="#1D4ED8"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StatusIconBorder"
                                Width="60"
                                Height="60"
                                VerticalAlignment="Top"
                                Background="#30FFFFFF"
                                CornerRadius="8">
                            <materialDesign:PackIcon x:Name="StatusIcon"
                                                     Width="29"
                                                     Height="29"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="White"
                                                     Kind="Update" />
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="StatusPillText"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#DBEAFE"
                                       Text="СИСТЕМА ОБНОВЛЕНИЙ" />
                            <TextBlock x:Name="StatusTitleText"
                                       Grid.Row="1"
                                       Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="Готово к проверке" />
                            <TextBlock x:Name="StatusDescriptionText"
                                       Grid.Row="2"
                                       Margin="0,5,0,13"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="#EFF6FF"
                                       Text="Проверим, появился ли новый выпуск программы."
                                       TextWrapping="Wrap" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="UpdateProgressBar"
                                             Height="7"
                                             VerticalAlignment="Center"
                                             Background="#35FFFFFF"
                                             BorderThickness="0"
                                             Foreground="White"
                                             Maximum="100"
                                             Value="0" />
                                <TextBlock x:Name="ProgressValueText"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="ГОТОВО" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <UniformGrid Margin="0,14,0,0" Columns="3">
                    <Border Margin="0,0,7,0"
                            Padding="15"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       Text="ТЕКУЩАЯ ВЕРСИЯ" />
                            <TextBlock x:Name="CurrentVersionText"
                                       Margin="0,5,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="0.1.1" />
                        </StackPanel>
                    </Border>
                    <Border Margin="7,0"
                            Padding="15"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       Text="КАНАЛ" />
                            <TextBlock x:Name="ChannelText"
                                       Margin="0,5,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Стабильный" />
                        </StackPanel>
                    </Border>
                    <Border Margin="7,0,0,0"
                            Padding="15"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       Text="РАЗМЕР ОБНОВЛЕНИЯ" />
                            <TextBlock x:Name="PackageSizeText"
                                       Margin="0,5,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Будет определён" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Что изменилось" />
                            <TextBlock x:Name="AvailableVersionText"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       FontSize="11"
                                       Foreground="#2563EB"
                                       Text="Новых выпусков пока нет" />
                        </Grid>
                        <ScrollViewer Grid.Row="2"
                                      MaxHeight="130"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReleaseNotesText"
                                       Margin="0,0,10,0"
                                       FontSize="12"
                                       LineHeight="19"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       Text="После проверки здесь появится краткое описание новой версии."
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <materialDesign:PackIcon Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         Foreground="#059669"
                                         Kind="ShieldCheckOutline" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource AppMutedBrush}"
                           Text="Настройки программы сохранятся после обновления."
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CheckAgainButton"
                        MinWidth="116"
                        Margin="0,0,10,0"
                        Style="{StaticResource UpdateSecondaryButton}"
                        Click="CheckAgain_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="17"
                                                 Height="17"
                                                 Margin="0,0,7,0"
                                                 Kind="Refresh" />
                        <TextBlock Text="Проверить" />
                    </StackPanel>
                </Button>
                <Button x:Name="PrimaryActionButton"
                        MinWidth="218"
                        Style="{StaticResource UpdatePrimaryButton}"
                        Click="PrimaryAction_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="PrimaryActionIcon"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 Kind="Refresh" />
                        <TextBlock x:Name="PrimaryActionText"
                                   VerticalAlignment="Center"
                                   Text="Проверить обновления" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
