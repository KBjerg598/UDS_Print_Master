<Window x:Class="UDS_Print_Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="UISI Print Master"
        Width="1320"
        Height="820"
        MinWidth="1220"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="Assets/UISI-Logo-BW.ico"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{StaticResource AppInkBrush}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppInkBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SmallMutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="MinHeight" Value="48" />
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="MinHeight" Value="48" />
        </Style>

        <Style x:Key="FileListActionsPanelStyle" TargetType="{x:Type WrapPanel}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="FileListActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="FileListPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="FilesGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource AppInkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource AppLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="FilesGridCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="{StaticResource AppLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FilesGridTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilesDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="BorderBrush" Value="{StaticResource AppLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource AppLineBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FilesGridColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FilesGridCellStyle}" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0"
                             Padding="20"
                             Background="{StaticResource AppSurfaceBrush}"
                             materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="68"
                        Height="68"
                        Background="#111827"
                        CornerRadius="16"
                        Padding="7"
                        VerticalAlignment="Center">
                    <Image Source="Assets/UISI-Logo-BW.png"
                           Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="UISI Print Master"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource AppInkBrush}" />
                    <TextBlock Text="Печать, конвертация и сканирование документов в одном рабочем пространстве"
                               Style="{StaticResource SmallMutedText}"
                               FontSize="13"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PrintQueueButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="PrintQueue_Click"
                            IsEnabled="{Binding CanPrint}"
                            Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Печатать очередь" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card x:Name="TemplatesPanel"
                                 Grid.Column="0"
                                 Padding="20"
                                 Background="{StaticResource AppSurfaceBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                 Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Шаблоны печати" Style="{StaticResource PanelTitle}" />

                        <ComboBox ItemsSource="{Binding Templates}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                  Style="{StaticResource SettingsComboBox}"
                                  materialDesign:HintAssist.Hint="Активный шаблон" />

                        <UniformGrid Columns="3" Margin="0,12,0,4">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="NewTemplate_Click"
                                    ToolTip="Новый шаблон"
                                    Margin="0,0,6,0">
                                <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="DuplicateTemplate_Click"
                                    ToolTip="Создать копию"
                                    Margin="0,0,6,0">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="DeleteTemplate_Click"
                                    ToolTip="Удалить шаблон"
                                    Foreground="#B91C1C">
                                <materialDesign:PackIcon Kind="Delete" Width="21" Height="21" />
                            </Button>
                        </UniformGrid>

                        <TextBox Text="{Binding SelectedTemplate.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBox}"
                                 materialDesign:HintAssist.Hint="Название шаблона" />

                        <TextBox Text="{Binding SelectedTemplate.Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBox}"
                                 materialDesign:HintAssist.Hint="Копий каждого файла" />

                        <ComboBox SelectedValue="{Binding SelectedTemplate.PageOrientation, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource SettingsComboBox}"
                                  materialDesign:HintAssist.Hint="Ориентация листа">
                            <ComboBoxItem Content="Книжная" Tag="Portrait" />
                            <ComboBoxItem Content="Альбомная" Tag="Landscape" />
                        </ComboBox>

                        <ComboBox SelectedValue="{Binding SelectedTemplate.DuplexMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource SettingsComboBox}"
                                  materialDesign:HintAssist.Hint="Режим печати">
                            <ComboBoxItem Content="Односторонняя" Tag="OneSided" />
                            <ComboBoxItem Content="Двусторонняя" Tag="TwoSidedLongEdge" />
                        </ComboBox>

                        <Border BorderBrush="{StaticResource AppLineBrush}"
                                BorderThickness="1"
                                Background="#F8FAFC"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <CheckBox Content="Расширенные настройки"
                                          IsChecked="{Binding IsAdvancedSettingsEnabled, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="OpenTemplateSettings_Click"
                                        IsEnabled="{Binding IsAdvancedSettingsEnabled}"
                                        Margin="0,14,0,0"
                                        Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Tune"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="Детальный шаблон" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Click="SaveTemplates_Click"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Сохранить шаблоны" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <materialDesign:Card x:Name="WorkspacePanel"
                                 Grid.Column="1"
                                 Padding="20"
                                 Background="{StaticResource AppSurfaceBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                 Margin="0,0,16,0"
                                 AllowDrop="True"
                                 DragOver="Window_DragOver"
                                 Drop="Window_Drop">
                <TabControl x:Name="MainWorkspaceTabs"
                            SelectionChanged="MainWorkspaceTabs_SelectionChanged"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                    <TabItem Header="Очередь печати">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Файлы для печати" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding FilesSummary}"
                                       Style="{StaticResource SmallMutedText}"
                                       Margin="0,-7,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Style="{StaticResource FileListActionsPanelStyle}">
                            <Button Style="{StaticResource FileListActionButtonStyle}"
                                    Click="AddFiles_Click"
                                    ToolTip="Добавить файлы в очередь печати">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePlus"
                                                             Width="19"
                                                             Height="19"
                                                             Margin="0,0,7,0" />
                                    <TextBlock Text="Добавить" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FileListActionButtonStyle}"
                                    Click="RemoveSelectedFiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                             Width="19"
                                                             Height="19"
                                                             Margin="0,0,7,0" />
                                    <TextBlock Text="Убрать" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FileListActionButtonStyle}"
                                    Click="ClearFiles_Click"
                                    Foreground="#B91C1C">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteSweep"
                                                             Width="19"
                                                             Height="19"
                                                             Margin="0,0,7,0" />
                                    <TextBlock Text="Очистить" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            Background="#F8FAFC"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,14,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox Content="Печатать все файлы по активному шаблону"
                                          IsChecked="{Binding UseOneTemplateForAll, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                                <TextBlock Text="Если выключить, каждый файл будет печататься по назначенному ему шаблону."
                                           Style="{StaticResource SmallMutedText}"
                                           Margin="0,5,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ApplyTemplateToSelected_Click"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlaylistCheck"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,7,0" />
                                    <TextBlock Text="Назначить выбранным" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="FilesGrid"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              SelectionMode="Extended"
                              SelectionChanged="FilesGrid_SelectionChanged"
                              RowHeaderWidth="0"
                              BorderThickness="1"
                              Background="#FFFFFF"
                              AlternationCount="2"
                              Style="{StaticResource FilesDataGridStyle}">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FilesGridTextStyle}" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Файл"
                                                Binding="{Binding FileName}"
                                                Width="2.2*" />
                            <DataGridTextColumn Header="Тип"
                                                Binding="{Binding Extension}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="Размер"
                                                Binding="{Binding SizeLabel}"
                                                Width="0.75*" />
                            <DataGridTextColumn Header="Шаблон"
                                                Binding="{Binding TemplateName}"
                                                Width="1.35*" />
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status}"
                                                Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            Background="#F8FAFC"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            ToolTipService.InitialShowDelay="150">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock Width="380"
                                           TextWrapping="Wrap"
                                           Text=".txt, .log, .csv, .json, .xml, .md, .ini, .sql, .html, .css, .js, .cs, .xaml, .yaml, .rtf, .docx, .pdf" />
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Поддерживаемые типы файлов"
                                       Style="{StaticResource SmallMutedText}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{StaticResource AppMutedBrush}"
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                    </TabItem>

                    <TabItem Header="Конвертация">
                        <Grid Margin="0,12,0,0"
                              AllowDrop="True"
                              DragOver="Conversion_DragOver"
                              Drop="Conversion_Drop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Конвертация в PDF" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="{Binding ConversionSummary}"
                                               Style="{StaticResource SmallMutedText}"
                                               Margin="0,-7,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Style="{StaticResource FileListActionsPanelStyle}">
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="AddConversionFiles_Click"
                                            ToolTip="Добавить файлы для конвертации">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePlus"
                                                                     Width="19"
                                                                     Height="19"
                                                                     Margin="0,0,7,0" />
                                            <TextBlock Text="Добавить" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="RemoveSelectedConversionFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                                     Width="19"
                                                                     Height="19"
                                                                     Margin="0,0,7,0" />
                                            <TextBlock Text="Убрать" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="ClearConversionFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DeleteSweep"
                                                                     Width="19"
                                                                     Height="19"
                                                                     Margin="0,0,7,0" />
                                            <TextBlock Text="Очистить" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FileListPrimaryActionButtonStyle}"
                                            Click="ConvertAllWordFiles_Click"
                                            IsEnabled="{Binding CanConvert}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox"
                                                                     Width="19"
                                                                     Height="19"
                                                                     Margin="0,0,7,0" />
                                            <TextBlock Text="В PDF" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource AppLineBrush}"
                                    BorderThickness="1"
                                    Background="#F8FAFC"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,14,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Sync"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="#1D4ED8"
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ConversionStatus}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <ProgressBar Value="{Binding ConversionProgressValue}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Margin="0,12,0,0"
                                                     Style="{StaticResource MaterialDesignLinearProgressBar}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2"
                                      x:Name="ConversionFilesGrid"
                                      ItemsSource="{Binding ConversionFiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      SelectionMode="Extended"
                                      RowHeaderWidth="0"
                                      BorderThickness="1"
                                      Background="#FFFFFF"
                                      AlternationCount="2"
                                      Style="{StaticResource FilesDataGridStyle}">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FilesGridTextStyle}" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Файл"
                                                        Binding="{Binding FileName}"
                                                        Width="2.5*" />
                                    <DataGridTextColumn Header="Тип"
                                                        Binding="{Binding Extension}"
                                                        Width="0.6*" />
                                    <DataGridTextColumn Header="Размер"
                                                        Binding="{Binding SizeLabel}"
                                                        Width="0.8*" />
                                    <DataGridTextColumn Header="Статус"
                                                        Binding="{Binding Status}"
                                                        Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3"
                                    BorderBrush="{StaticResource AppLineBrush}"
                                    BorderThickness="1"
                                    Background="#F8FAFC"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    ToolTipService.InitialShowDelay="150">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Width="340"
                                                   TextWrapping="Wrap"
                                                   Text="Перед конвертацией программа попросит выбрать папку сохранения PDF. Поддерживаются текстовые файлы, RTF и DOCX без запуска Word." />
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Параметры конвертации"
                                               Style="{StaticResource SmallMutedText}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource AppMutedBrush}"
                                                             Margin="8,0,0,0"
                                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Сканирование">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource AppLineBrush}"
                                    BorderThickness="1"
                                    Background="#F8FAFC"
                                    CornerRadius="8"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Параметры сканирования"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Click="RefreshScanners_Click"
                                                    IsEnabled="{Binding CanWakeScanner}"
                                                    ToolTip="Пробудить и обновить сканер">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="21"
                                                                         Height="21" />
                                            </Button>
                                        </Grid>

                                        <ComboBox ItemsSource="{Binding Scanners}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedScanner, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanWakeScanner}"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  materialDesign:HintAssist.Hint="Сканер" />

                                        <ComboBox SelectedValue="{Binding SelectedScanSource, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  IsEnabled="{Binding CanWakeScanner}"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  materialDesign:HintAssist.Hint="Источник бумаги">
                                            <ComboBoxItem Content="Планшетный сканер" Tag="Flatbed" />
                                            <ComboBoxItem Content="Автоподатчик (ADF)" Tag="Feeder" />
                                        </ComboBox>

                                        <ComboBox SelectedValue="{Binding SelectedScanMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  IsEnabled="{Binding CanWakeScanner}"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  materialDesign:HintAssist.Hint="Стороны листа">
                                            <ComboBoxItem Content="Одностороннее" Tag="Simplex" />
                                            <ComboBoxItem Content="Двустороннее" Tag="Duplex" />
                                        </ComboBox>

                                        <ComboBox ItemsSource="{Binding AvailableScanDpi}"
                                                  SelectedItem="{Binding SelectedScanDpi, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanWakeScanner}"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  materialDesign:HintAssist.Hint="Разрешение (DPI)" />

                                        <ComboBox SelectedValue="{Binding SelectedScanColorMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  IsEnabled="{Binding CanWakeScanner}"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  materialDesign:HintAssist.Hint="Цвет">
                                            <ComboBoxItem Content="Цветной" Tag="Color" />
                                            <ComboBoxItem Content="Оттенки серого" Tag="Grayscale" />
                                            <ComboBoxItem Content="Чёрно-белый" Tag="BlackAndWhite" />
                                        </ComboBox>

                                        <TextBox Text="{Binding ScanBaseFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBox}"
                                                 materialDesign:HintAssist.Hint="Префикс новых документов" />

                                        <Border Background="#EAF2FF"
                                                BorderBrush="#C7D7FE"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ScannerCapabilityText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Foreground="#334155" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Click="StartScan_Click"
                                                    IsEnabled="{Binding CanStartScan}"
                                                    Padding="16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Scanner"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Margin="0,0,8,0" />
                                                    <TextBlock Text="Сканировать" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Click="StopScan_Click"
                                                    IsEnabled="{Binding CanStopScan}"
                                                    Margin="8,0,0,0"
                                                    Foreground="#B91C1C"
                                                    ToolTip="Остановить после текущей страницы">
                                                <materialDesign:PackIcon Kind="Stop"
                                                                         Width="22"
                                                                         Height="22" />
                                            </Button>
                                        </Grid>

                                        <ProgressBar IsIndeterminate="True"
                                                     Height="6"
                                                     Margin="0,14,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsScannerBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <TextBlock Text="{Binding ScanStatus}"
                                                   Style="{StaticResource SmallMutedText}"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Отсканированные страницы"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScanPagesSummary}"
                                               Style="{StaticResource SmallMutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Margin="0,12,0,8">
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="SplitScanDocument_Click"
                                            IsEnabled="{Binding CanEditScans}"
                                            ToolTip="Следующая страница станет началом нового PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCut"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Margin="0,0,6,0" />
                                            <TextBlock Text="Разделить после" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="JoinScanDocument_Click"
                                            IsEnabled="{Binding CanEditScans}"
                                            ToolTip="Убрать разделитель перед выбранной страницей">
                                        <TextBlock Text="Объединить с предыдущим" />
                                    </Button>
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="DeleteSelectedScans_Click"
                                            IsEnabled="{Binding CanEditScans}"
                                            Foreground="#B91C1C">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DeleteOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Margin="0,0,6,0" />
                                            <TextBlock Text="Удалить" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FileListActionButtonStyle}"
                                            Click="ClearScans_Click"
                                            IsEnabled="{Binding CanEditScans}">
                                        <TextBlock Text="Очистить всё" />
                                    </Button>
                                </WrapPanel>

                                <Border Grid.Row="2"
                                        Background="#EEF2F7"
                                        BorderBrush="{StaticResource AppLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ListBox x:Name="ScansList"
                                             ItemsSource="{Binding ScanPages}"
                                             SelectedItem="{Binding SelectedScanPage, Mode=TwoWay}"
                                             SelectionMode="Extended"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="158">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="#DBEAFE"
                                                            BorderBrush="#93C5FD"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,3"
                                                            Margin="0,0,0,5"
                                                            Visibility="{Binding IsDocumentStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBox Text="{Binding DocumentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="2,0"
                                                                 Foreground="#1D4ED8"
                                                                 FontSize="11"
                                                                 FontWeight="SemiBold"
                                                                 TextAlignment="Center"
                                                                 ToolTip="Имя сохраняемого PDF" />
                                                    </Border>
                                                    <Border Grid.Row="1"
                                                            Background="White"
                                                            BorderBrush="#CBD5E1"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="5">
                                                        <StackPanel>
                                                            <Border Height="170" Background="#F8FAFC">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="Uniform" />
                                                            </Border>
                                                            <TextBlock Text="{Binding PageLabel}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center"
                                                                       Margin="0,6,0,1" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Просмотр страницы"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Grid.Row="1"
                                        Background="#E9EEF5"
                                        BorderBrush="{StaticResource AppLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">
                                    <Image Source="{Binding SelectedScanPreview}"
                                           Stretch="Uniform" />
                                </Border>
                                <Button Grid.Row="2"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="SaveScans_Click"
                                        IsEnabled="{Binding CanSaveScans}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,12,0,0"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FilePdfBox"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="Сохранить документы в PDF" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>

            <materialDesign:Card x:Name="PrintPreviewPanel"
                                 Grid.Column="2"
                                 Padding="20"
                                 Background="{StaticResource AppSurfaceBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Предпросмотр печати" Style="{StaticResource PanelTitle}" />

                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding PrinterNames}"
                              SelectedItem="{Binding SelectedPrinterName, Mode=TwoWay}"
                              Style="{StaticResource SettingsComboBox}"
                              materialDesign:HintAssist.Hint="Принтер"
                              Margin="0,0,0,12" />

                    <Border Grid.Row="2"
                            Background="{StaticResource AppSoftBlueBrush}"
                            BorderBrush="#C7D7FE"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterCheck"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="#1D4ED8"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Сейчас печатается"
                                           Foreground="{StaticResource AppMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentPrintingFile}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <ProgressBar Value="{Binding ProgressValue}"
                                         Maximum="100"
                                         Height="8"
                                         Margin="0,13,0,0"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}" />
                            <TextBlock Text="{Binding OverallStatus}"
                                       Style="{StaticResource SmallMutedText}"
                                       Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#E9EEF5"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                        <Grid>
                            <Border x:Name="FlowPreviewHost"
                                    Background="#E9EEF5"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="PreviewDrag_MouseLeftButtonDown"
                                    PreviewMouseMove="PreviewDrag_MouseMove"
                                    PreviewMouseLeftButtonUp="PreviewDrag_MouseLeftButtonUp"
                                    MouseLeave="PreviewDrag_MouseLeave">
                                <FlowDocumentScrollViewer x:Name="PrintPreviewViewer"
                                                          IsToolBarVisible="False"
                                                          Zoom="72"
                                                          MinZoom="45"
                                                          MaxZoom="140"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto" />
                            </Border>

                            <Border x:Name="PdfPreviewHost"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="PdfPreviewDrag_MouseLeftButtonDown"
                                    PreviewMouseMove="PdfPreviewDrag_MouseMove"
                                    PreviewMouseLeftButtonUp="PdfPreviewDrag_MouseLeftButtonUp"
                                    MouseLeave="PdfPreviewDrag_MouseLeave">
                                <wv2:WebView2 x:Name="PdfPreviewBrowser"
                                              Cursor="Hand"
                                              PreviewMouseLeftButtonDown="PdfPreviewDrag_MouseLeftButtonDown"
                                              PreviewMouseMove="PdfPreviewDrag_MouseMove"
                                              PreviewMouseLeftButtonUp="PdfPreviewDrag_MouseLeftButtonUp"
                                              MouseLeave="PdfPreviewDrag_MouseLeave" />
                            </Border>

                            <Border x:Name="PreviewMessageHost"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed"
                                    Padding="18">
                                <TextBlock x:Name="PreviewMessage"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AppMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <wv2:WebView2 x:Name="ConversionPdfBrowser"
                      Grid.RowSpan="2"
                      Width="1"
                      Height="1"
                      Visibility="Hidden"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
    </Grid>
</Window>
