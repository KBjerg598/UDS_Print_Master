<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>UISI PrintMaster</AssemblyName>
    <RootNamespace>UDS_Print_Master</RootNamespace>
    <Title>UISI PrintMaster</Title>
    <Product>UISI PrintMaster</Product>
    <Description>Печать, конвертация и сканирование документов.</Description>
    <Company>UISI</Company>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
    <RepositoryUrl>https://github.com/KBjerg598/UDS_Print_Master</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <StartupObject>UDS_Print_Master.App</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\UISI-Logo-BW.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyName>UISI PrintMaster.Debug</AssemblyName>
    <OutputPath>..\artifacts\debug\bin\</OutputPath>
    <IntermediateOutputPath>..\artifacts\debug\obj\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\UISI-Logo-BW.png" />
    <Resource Include="Assets\UISI-Logo-Header.png" />
    <Resource Include="Assets\UISI-Logo-BW.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="PDFiumCore" Version="152.0.7947" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="update-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <Target Name="RemoveDebugSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
