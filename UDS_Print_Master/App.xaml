<Application x:Class="UDS_Print_Master.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppInkBrush" Color="#111827" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#64748B" />
            <SolidColorBrush x:Key="AppLineBrush" Color="#DCE3EC" />
            <SolidColorBrush x:Key="AppSoftBlueBrush" Color="#EDF4FF" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#F8FAFC" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
