<Application x:Class="UDS_Print_Master.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UDS_Print_Master"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppInkBrush" Color="#111827" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#64748B" />
            <SolidColorBrush x:Key="AppLineBrush" Color="#DCE3EC" />
            <SolidColorBrush x:Key="AppSoftBlueBrush" Color="#EDF4FF" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#F8FAFC" />

            <Style x:Key="AppWindowStyle"
                   TargetType="Window"
                   BasedOn="{StaticResource MaterialDesignWindow}">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppInkBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource MaterialDesignFont}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="WindowStyle" Value="None" />
                <Setter Property="MaxHeight"
                        Value="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}" />
                <Setter Property="shell:WindowChrome.WindowChrome">
                    <Setter.Value>
                        <shell:WindowChrome CaptionHeight="42"
                                            CornerRadius="8"
                                            GlassFrameThickness="0"
                                            ResizeBorderThickness="7"
                                            UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Window">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource AppLineBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <local:MaterialTitleBar Grid.Row="0" />
                                    <AdornerDecorator Grid.Row="1">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </AdornerDecorator>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
